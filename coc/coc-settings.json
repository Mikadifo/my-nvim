{
  "prisma.prismaFmtBinPath": "./node_modules/.bin/prisma",
  "prisma.languageServerPath": "~/.config/coc/extensions/node_modules/coc-prisma/node_modules/.bin/prisma-language-server",
  "clangd.path": "~/.config/coc/extensions/coc-clangd-data/install/17.0.3/clangd_17.0.3/bin/clangd",
  "tailwindCSS.emmetCompletions": true,
  "emmet.includeLanguages": { "javascript": "javascriptreact" },
  "coc.preferences.formatOnSave": true,
  "suggest.noselect": false,
  "languageserver": {
    "haskell": {
      "command": "haskell-language-server-wrapper",
      "args": ["--lsp"],
      "rootPatterns": [
        "*.cabal",
        "stack.yaml",
        "cabal.project",
        "package.yaml",
        "hie.yaml"
      ],
      "filetypes": ["hs", "lhs", "haskell", "lhaskell"]
    }
  },
  "snippets.ultisnips.pythonPrompt": false,
  "pyright.inlayHints.functionReturnTypes": false,
  "pyright.inlayHints.variableTypes": false,
  "pyright.inlayHints.parameterTypes": false
}
